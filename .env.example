# Copy to .env. Default mode stores videos locally and needs no cloud credentials.
PORT=8000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_MODE=local
# For phone access use a reachable HTTPS origin, HOST=0.0.0.0, and a long random device token.
DEVICE_TOKEN=

# STORAGE_MODE=oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional for temporary server credentials (must be refreshed operationally):
OSS_STS_TOKEN=
# Custom HTTPS domain bound to the private bucket, e.g. https://media.example.com
OSS_PUBLIC_DOMAIN=
# Optional system FFmpeg override; otherwise uses ffmpeg-static.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
